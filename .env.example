# ====================================================================
# Plantilla de entorno Outline. Copiar a .env y rellenar.
# Generar secrets: openssl rand -hex 32
# ====================================================================

# --- Core / red ---
URL=http://localhost:3000
OUTLINE_PORT=3000
FORCE_HTTPS=false

# --- Secrets ---
SECRET_KEY=
UTILS_SECRET=

# --- PostgreSQL ---
POSTGRES_USER=outline
POSTGRES_PASSWORD=
POSTGRES_DB=outline

# --- File storage (local) ---
FILE_STORAGE_UPLOAD_MAX_SIZE=5368709120

# --- OIDC ---
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_LOGOUT_URI=
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=OIDC
OIDC_SCOPES=openid profile email

# --- Google Workspace (opcional) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
